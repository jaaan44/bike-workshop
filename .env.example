APP_NAME="Bike Workshop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Keep this in sync with APP_PORT below if you change it — plain literal
# rather than ${APP_PORT} because .env variable interpolation only sees
# variables defined earlier in the file, and APP_PORT is defined later.
APP_URL=http://localhost:8013

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bike_workshop
DB_USERNAME=sail
DB_PASSWORD=password

# --- Docker host port mappings ---------------------------------------------
# Read by docker compose (via compose.yaml's ${VAR:-default} syntax) from
# this same file — NOT read by Laravel itself. These are HOST-side ports
# only; inside the Docker network the app always reaches MySQL at
# mysql:3306 regardless of what DB_FORWARD_PORT is set to (see DB_HOST/
# DB_PORT above, which must stay mysql/3306).
#
# Chosen to avoid colliding with other projects sharing this host/VPS —
# change these if 8013/3348/5175 are already in use here (see README).
APP_PORT=8013
DB_FORWARD_PORT=3348
VITE_FORWARD_PORT=5175

# Staging/production only (Phase 11C): uncomment the line below in that
# environment's real .env (never in this example file) to make Compose
# ignore compose.override.yaml's local-dev-only MySQL host port. With this
# set, `docker compose up -d` there only ever loads compose.yaml, whose own
# defaults already bind the app port to 127.0.0.1 and publish no MySQL host
# port at all — see compose.yaml and compose.override.yaml for detail.
# COMPOSE_FILE=compose.yaml

# Set to true to run `php artisan db:seed` automatically every time the
# `app` container starts. Off by default everywhere, including the VPS —
# intended for a throwaway local/dev database only.
DB_SEED_ON_BOOT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
